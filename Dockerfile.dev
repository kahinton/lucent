FROM python:3.12-slim

WORKDIR /app

# Install runtime + build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Copy project files for initial install
COPY pyproject.toml README.md ./
COPY src/ src/
# Top-level daemon package — required by the editable install too, so the
# daemon imports even without the Compose bind mount.
COPY daemon/ daemon/
# Built-in definitions (skills, agents, sandbox templates). Compose bind-mounts
# these at runtime, but the image should stand on its own: without this a dev
# image started without the mounts silently has no built-in skills.
COPY .github/ /app/.github/

# Keep pip patched in development images as well as local virtualenvs.
RUN python -m pip install --no-cache-dir --upgrade pip

# Install in editable mode so volume-mounted source changes are live
RUN pip install --no-cache-dir -e ".[dev]" 2>/dev/null || pip install --no-cache-dir -e .

EXPOSE 8766

CMD ["lucent"]
