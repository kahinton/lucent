FROM python:3.12-slim

WORKDIR /app

# Optional native tool handlers — same gating as the production Dockerfile.
# Defaults keep the dev image's package set unchanged.
ARG LUCENT_TOOLS_ENABLE_DOCUMENTS=0
ARG LUCENT_TOOLS_ENABLE_IMAGES=0
ENV LUCENT_TOOLS_ENABLE_DOCUMENTS=${LUCENT_TOOLS_ENABLE_DOCUMENTS} \
    LUCENT_TOOLS_ENABLE_IMAGES=${LUCENT_TOOLS_ENABLE_IMAGES}

# Install runtime + build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Copy project files for initial install
COPY pyproject.toml README.md ./
COPY src/ src/
# Top-level daemon package — required by the editable install too, so the
# daemon imports even without the Compose bind mount.
COPY daemon/ daemon/
# Built-in definitions (skills, agents, sandbox templates). Compose bind-mounts
# these at runtime, but the image should stand on its own: without this a dev
# image started without the mounts silently has no built-in skills.
COPY .github/ /app/.github/

# Keep pip patched in development images as well as local virtualenvs.
RUN python -m pip install --no-cache-dir --upgrade pip

# Install in editable mode so volume-mounted source changes are live.
# Extras are assembled first so the optional tool packages follow the same
# LUCENT_TOOLS_ENABLE_* gating as the production image; with both flags at
# their default of 0 the specifier is exactly `.[dev]`, as before. The
# `|| pip install -e .` fallback only applies to that default case — if an
# operator explicitly opted into extras, a resolution failure must be visible
# rather than silently producing an image without the requested tools.
RUN EXTRAS="dev" ; \
    if [ "$LUCENT_TOOLS_ENABLE_DOCUMENTS" = "1" ]; then EXTRAS="$EXTRAS,tools-documents" ; fi ; \
    if [ "$LUCENT_TOOLS_ENABLE_IMAGES" = "1" ]; then EXTRAS="$EXTRAS,tools-images" ; fi ; \
    if [ "$EXTRAS" = "dev" ]; then \
        pip install --no-cache-dir -e ".[dev]" 2>/dev/null || pip install --no-cache-dir -e . ; \
    else \
        pip install --no-cache-dir -e ".[${EXTRAS}]" ; \
    fi

# Semantic memory embeddings (fastembed / ONNX Runtime). The model weights are
# fetched here, at build time, into a fixed path so the running container can
# encode with the network disabled. This is the image the Compose stack builds
# (docker-compose.yml: lucent + daemon-1 both use Dockerfile.dev), so without
# this block the live stack would have the fastembed package but no model.
#
# FASTEMBED_CACHE_PATH is fastembed's own default cache env var;
# LUCENT_EMBEDDING_CACHE_DIR is what the application resolves the cache through
# (settings.py: memory.embedding_cache_dir). Both must point at /opt/models or
# runtime would look somewhere the weights are not.
ARG LUCENT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ENV FASTEMBED_CACHE_PATH=/opt/models \
    LUCENT_EMBEDDING_CACHE_DIR=/opt/models \
    LUCENT_EMBEDDING_MODEL=${LUCENT_EMBEDDING_MODEL} \
    HF_HUB_DISABLE_TELEMETRY=1
RUN mkdir -p /opt/models && python -m lucent.memory.embeddings --download

# Build-time assertion, deliberately separate from the fetch. If the download
# step silently no-ops (wrong path, empty cache, interrupted transfer), this
# fails the build here instead of the first memory write at runtime. It checks
# the actual on-disk artifacts fastembed loads: a non-empty ONNX model plus the
# tokenizer and config files, all under /opt/models.
RUN python -c "import pathlib, sys; \
c = pathlib.Path('/opt/models'); \
onnx = [p for p in c.rglob('*.onnx') if p.exists() and p.stat().st_size > 0]; \
names = {p.name for p in c.rglob('*') if p.exists()}; \
required = ['tokenizer.json', 'config.json', 'tokenizer_config.json']; \
missing = [n for n in required if n not in names]; \
sys.exit('ERROR: embedding cache incomplete under /opt/models: onnx=%s missing=%s' % (onnx, missing)) if (not onnx or missing) else print('embedding cache OK: %d onnx file(s), %d bytes' % (len(onnx), sum(p.stat().st_size for p in onnx)))"

EXPOSE 8766

CMD ["lucent"]
