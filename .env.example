# =============================================================================
# Lucent Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment.
# NEVER commit .env to version control — it contains secrets.
#
# For production: all *_PASSWORD and *_KEY values MUST be set to strong randoms.
# Generate with: openssl rand -base64 32
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=lucent
POSTGRES_PASSWORD=change-me-use-openssl-rand
POSTGRES_DB=lucent

# Daemon DB role password (separate least-privilege role)
DAEMON_DB_PASSWORD=change-me-use-openssl-rand

# Database URL (for running outside Docker Compose)
# DATABASE_URL=postgresql://lucent:YOUR_PASSWORD@localhost:5433/lucent

# Server Configuration
LUCENT_HOST=0.0.0.0
LUCENT_PORT=8766

# Deployment Mode (personal or team)
# Team mode requires a license key
LUCENT_MODE=personal
# LUCENT_LICENSE_KEY=your-license-key

# Authentication Provider (basic or api_key)
LUCENT_AUTH_PROVIDER=basic

# Session TTL in hours (default: 24)
LUCENT_SESSION_TTL_HOURS=24

# Log format: human or json (default: human)
LUCENT_LOG_FORMAT=human
# LUCENT_LOG_LEVEL=INFO

# Database port (for docker-compose, default: 5433)
# LUCENT_DB_PORT=5433

# Rate limiting (requests per minute per API key, default: 100)
# LUCENT_RATE_LIMIT_PER_MINUTE=100

# Cookie security (defaults to true; set to false ONLY for local HTTP development)
# LUCENT_SECURE_COOKIES=true

# HMAC signing secret for impersonation cookies.
# MUST be set to a stable value for cookie persistence across restarts.
# Generate with: openssl rand -base64 32
# LUCENT_SIGNING_SECRET=

# CORS origins (comma-separated, restrict in production)
# LUCENT_CORS_ORIGINS=https://your-domain.com

# Canonical public URL when Lucent is exposed through a reverse proxy or tunnel.
# This also permits the hostname through MCP DNS-rebinding protection.
# LUCENT_PUBLIC_URL=https://lucent.example.com

# Additional MCP hostnames, if clients use names other than LUCENT_PUBLIC_URL.
# LUCENT_MCP_ALLOWED_HOSTS=lucent.example.com

# Proxy IPs/CIDRs trusted when deriving client IPs from X-Forwarded-For.
# For cloudflared running on the Docker host, this is typically the Docker bridge
# gateway or subnet; verify the direct peer address before setting it.
# LUCENT_TRUSTED_PROXIES=172.16.0.0/12

# Secret Storage Provider (builtin, vault, aws, or azure)
LUCENT_SECRET_PROVIDER=builtin
LUCENT_SECRET_KEY=change-me-use-openssl-rand

# Credential encryption for integration credentials (Slack/Discord tokens).
# Lucent requires a running OpenBao/Vault instance with the transit backend enabled.
# No local encryption keys are needed — encryption is handled by the secret store.
# See docs/secret-storage.md for setup instructions.

# OpenBao / Vault Configuration
BAO_DEV_ROOT_TOKEN_ID=change-me-insecure-dev-root-token
VAULT_TOKEN=change-me-insecure-dev-root-token

# ----------------------------------------------------------------------------
# File Storage
# ----------------------------------------------------------------------------
# Backend for user file uploads/revisions. "local" (default) writes to
# LUCENT_FILE_STORAGE_PATH on disk; "azure" writes to Azure Blob Storage using
# DefaultAzureCredential's chain (managed identity plus environment/CLI/dev
# credentials). It never uses a storage account key, connection string, or SAS.
# Legacy rows keep their own provider, so switching does not break reads of
# files already stored; revisions of an existing file also stay on its provider.
# LUCENT_FILE_STORAGE_PROVIDER=local
# LUCENT_FILE_STORAGE_PATH=./data/files

# Azure Blob Storage (required when LUCENT_FILE_STORAGE_PROVIDER=azure).
# The account URL must be exactly https://<account>.blob.core.windows.net
# (no port, path, query, or embedded credentials); it is validated at startup.
# The container must already exist and be readable by the identity — a missing
# or inaccessible container fails loudly instead of surfacing as "file not found".
# LUCENT_AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# LUCENT_AZURE_STORAGE_CONTAINER=lucent-files
# Selects a user-assigned managed identity when set; DefaultAzureCredential
# otherwise falls through its environment/CLI/developer credential chain.
# AZURE_CLIENT_ID=

# Storage quotas (bytes). The per-file cap falls back to the legacy
# LUCENT_MAX_USER_FILE_BYTES. Per-user/per-org default to 1 GiB / 10 GiB and are
# counted across every revision of a user's non-deleted files.
# LUCENT_MAX_USER_FILE_BYTES=10485760
# LUCENT_MAX_USER_FILE_BYTES_PER_USER=1073741824
# LUCENT_MAX_USER_FILE_BYTES_PER_ORG=10737418240

# Sandbox Configuration
# Task sandboxes are created by the dispatcher, which runs inside a per-org
# worker, so every value below must be present in the DAEMON's environment as
# well as the web app's. Docker is the local default and needs no extra config.
# LUCENT_SANDBOXES_ENABLED=true
# LUCENT_SANDBOX_BACKEND=docker
#
# Azure Container Instances (LUCENT_SANDBOX_BACKEND=aci). Groups run in a
# delegated subnet with a private IP and no public endpoint.
# LUCENT_SANDBOX_ACI_RESOURCE_GROUP=
# LUCENT_SANDBOX_ACI_SUBNET_ID=
# LUCENT_SANDBOX_ACI_LOCATION=
# Only needed for private ACR images; must hold AcrPull and nothing else.
# LUCENT_SANDBOX_ACI_IDENTITY_ID=
# ACI has no per-sandbox egress policy, so `allowlist` mode fails closed unless
# this acknowledges that egress is governed by the subnet NSG.
# LUCENT_SANDBOX_ACI_ALLOW_SUBNET_EGRESS=0
#
# The Lucent API as reachable from inside a sandbox. The `/api` suffix is
# required. On ACI it must not be the Docker-only loopback default.
# LUCENT_SANDBOX_BRIDGE_API_URL=http://host.docker.internal:8766/api
# LUCENT_SANDBOX_BRIDGE_IMAGE=lucent-sandbox:base
# AZURE_SUBSCRIPTION_ID=
# The app process authenticates with AZURE_CLIENT_ID. Workers must run as the
# app identity too, but the controller's AZURE_CLIENT_ID stays the controller
# identity; export the app identity separately and the worker launcher maps it
# to AZURE_CLIENT_ID in the worker only.
# LUCENT_WORKER_AZURE_CLIENT_ID=

# Daemon Configuration
# LUCENT_MAX_SESSIONS=3
# LUCENT_DAEMON_INTERVAL=15
# Leave unset to use the enabled model registry default; set only to pin daemon sessions.
# LUCENT_DAEMON_MODEL=
# Execution model: one always-on controller per deployment supervises ephemeral
# per-org worker containers. `docker compose up` runs the controller; workers are
# spawned on demand. Requires container-create access (the Docker socket proxy
# already provides it) and the daemon source present in the image.
#
# Roles to run in the always-on process. "all" = scheduler + controller; the
# dispatcher runs only inside the workers the controller spawns.
# LUCENT_DAEMON_ROLES=all
#
# Workers the controller keeps alive per organization even with nothing queued.
#   0 = scale to zero (work spawns a worker, which exits when idle)
#   1 = one worker always ready, so work starts without a cold start (default)
#   N = a larger standby pool
# This replaces the old always_on/on_demand mode flag: 0 is the old on_demand,
# 1 is the default and what always_on used to buy you.
# LUCENT_DAEMON_WORKER_MIN_WARM=1
# Seconds a worker above the warm floor stays alive with no work before exiting.
# LUCENT_DAEMON_WORKER_IDLE_SECONDS=300
# Worker spawn backend: docker (local container parity), kubernetes (Jobs on a
# cluster), or azure (Container Apps Jobs). See docs/azure-deployment-design.md.
# LUCENT_WORKER_LAUNCHER=docker
# Azure also needs LUCENT_WORKER_JOB_NAME, LUCENT_WORKER_RESOURCE_GROUP and
# LUCENT_WORKER_SUBSCRIPTION_ID; deploy/terraform/README.md provisions them.

# Non-interactive provisioning
# The browser /setup flow stays the default for local use. These make a fresh
# instance provisionable without one — a container can create the first owner,
# enable a usable model and mint an API key by itself. The startup path is
# opt-in and only ever runs when no human user exists, so it cannot reset an
# existing instance. The CLI equivalents are `lucent-bootstrap` and
# `lucent-migrate` (`python -m lucent.bootstrap` / `python -m lucent.migrate`).
# LUCENT_BOOTSTRAP_ON_STARTUP=false
# Password for the first owner account — take it from a secret, never commit it.
# LUCENT_BOOTSTRAP_PASSWORD=
# LUCENT_BOOTSTRAP_EMAIL=
# LUCENT_BOOTSTRAP_DISPLAY_NAME=
# LUCENT_BOOTSTRAP_ORG_NAME=
# Model to enable so the instance is usable with no provider credentials.
# LUCENT_BOOTSTRAP_MODEL=
# Where the minted API key is written (0600); omitted means it is not persisted.
# LUCENT_BOOTSTRAP_API_KEY_FILE=
# Password for the restricted lucent_daemon role, created by the migration
# prerequisites step. Required on a managed database where the role does not
# already exist.
# DAEMON_DB_PASSWORD=
# LUCENT_MCP_URL=http://localhost:8766/mcp
# LUCENT_MCP_API_KEY=hs_your_api_key_here
# LUCENT_STALE_HEARTBEAT_MINUTES=30
# Maximum consecutive LangChain tool-call rounds per session (default: 0 = unlimited; maximum: 1000).
# LUCENT_LANGCHAIN_MAX_TOOL_ROUNDS=0
# Disabled by default because automatic source reload can interrupt durable work.
# Set true only for local development, then restart daemon containers.
# LUCENT_DAEMON_SOURCE_RELOAD=false
# Used only when DAEMON_DATABASE_URL and DATABASE_URL are unset (personal mode).
# Override if your local postgres password differs from docker-compose defaults.
# LUCENT_DEV_DATABASE_URL=postgresql://lucent:your-local-password@localhost:5433/lucent

# Daemon Review & Approval
# Auto-approve daemon-initiated requests (set false to require human approval)
# LUCENT_AUTO_APPROVE=false
# Skip the daemon's automatic post-completion quality review
# LUCENT_SKIP_POST_REVIEW=false
# Require human approval of completed requests (moves them to "review" status)
# LUCENT_REQUIRE_APPROVAL=false

# LLM Engine: "copilot" (default), "langchain", "claude_code", or "codex".
# Engines are llm_access (langchain = general LLM layer) or coding_agent
# (copilot / claude_code / codex). The coding engines are backed by official
# Python SDKs that bundle their own CLIs and ship in the base install
# (no Node/npm needed).
# LUCENT_LLM_ENGINE=copilot
# Leave unset to use the enabled model registry default for chat sessions.
# LUCENT_CHAT_MODEL=

# Local (OSS) model providers are used by coding engines via an Engine Backend
# (engine=codex, provider=ollama). Base URLs fall back to these env vars:
# OLLAMA_HOST=http://localhost:11434
# LMSTUDIO_HOST=http://localhost:1234
# LOCAL_OPENAI_BASE_URL=

# Auto-route by task type: when true, code/agentic work prefers a coding-agent
# engine and plain chat uses the general engine. Off keeps the default engine.
# LUCENT_ENGINE_AUTO_ROUTE=false

# LLM Provider API Keys (only needed when LUCENT_LLM_ENGINE=langchain)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# GitHub Token — REQUIRED for daemon and chat features when using Copilot SDK engine.
# Must be a GitHub personal access token (classic) with "copilot" scope,
# or a fine-grained token with GitHub Copilot permissions.
# The daemon and chat features use this to call LLM models via the GitHub Copilot SDK.
# Not needed if LUCENT_LLM_ENGINE=langchain (uses provider API keys instead).
# GITHUB_TOKEN=your_github_token_here
